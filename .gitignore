# Only the review artifact is versioned. Research workspace files stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/code/
!/configs/
!/tests/
!/results/
/tests/*
!/tests/review/
/results/*
!/results/README.md
!/results/MANIFEST.json
!/results/primary/
!/results/persistence/
!/results/figures/
!/results/logs/
__pycache__/
*.py[cod]
.env
.env.*
.venv/
*.log
